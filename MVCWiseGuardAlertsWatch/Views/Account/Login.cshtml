@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<div class="auth-card">
    <h1>Sign in</h1>
    @if (TempData["Success"] is string msg)
    {
        <div class="alert success">@msg</div>
    }
    <form asp-action="Login" method="post" class="stack-form">
        <div asp-validation-summary="ModelOnly" class="alert danger"></div>
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <label>Email</label>
        <input asp-for="Email" class="input" required />
        <label>Password</label>
        <input asp-for="Password" type="password" class="input" required />
        <button class="btn primary">Sign In</button>
    </form>
    <p class="muted small"><a asp-action="Register">Create an account</a> &middot; <a asp-action="ForgotPassword">Forgot password?</a></p>
</div>
