@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot password"; }
<div class="auth-card">
    <h1>Forgot password</h1>
    @if (ViewData["Message"] is string msg)
    {
        <div class="alert info">@msg</div>
    }
    <form asp-action="ForgotPassword" method="post" class="stack-form">
        <label>Account email</label>
        <input asp-for="Email" type="email" class="input" required />
        <button class="btn primary">Generate reset code</button>
    </form>
    <p class="muted small"><a asp-action="ResetPassword">I have a reset code</a></p>
</div>
