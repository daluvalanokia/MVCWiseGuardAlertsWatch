@model RegisterViewModel
@{ ViewData["Title"] = "Register"; }
<div class="auth-card">
    <h1>Create account</h1>
    <form asp-action="Register" method="post" class="stack-form">
        <div asp-validation-summary="All" class="alert danger"></div>
        <label>Full name</label>
        <input asp-for="FullName" class="input" required />
        <label>Email</label>
        <input asp-for="Email" type="email" class="input" required />
        <label>Password (min 8 chars)</label>
        <input asp-for="Password" type="password" class="input" minlength="8" required />
        <label>Confirm password</label>
        <input asp-for="ConfirmPassword" type="password" class="input" required />
        <button class="btn primary">Register</button>
    </form>
    <p class="muted small">Already registered? <a asp-action="Login">Sign in</a></p>
</div>
