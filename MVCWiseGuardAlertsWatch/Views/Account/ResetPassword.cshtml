@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }
<div class="auth-card">
    <h1>Reset password</h1>
    <form asp-action="ResetPassword" method="post" class="stack-form">
        <div asp-validation-summary="All" class="alert danger"></div>
        <label>Reset code</label>
        <input asp-for="Token" class="input" required />
        <label>New password (min 8 chars)</label>
        <input asp-for="Password" type="password" class="input" minlength="8" required />
        <label>Confirm password</label>
        <input asp-for="ConfirmPassword" type="password" class="input" required />
        <button class="btn primary">Reset</button>
    </form>
</div>
