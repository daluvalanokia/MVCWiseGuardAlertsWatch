@model DashboardViewModel
@{
    ViewData["Title"] = "Location Radar";
    var settings = Model.Settings;
    var jsonOpts = new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web);
    var radarConfigsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.RadarConfigs.Select(c => new { c.Id, c.Name, c.InstancesJson }), jsonOpts);
    var proxiesJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Proxies.Select(p => new { p.Id, Name = p.DisplayName ?? p.Name, p.Lat, p.Lon }), jsonOpts);
}
<div id="dashboard"
     data-interval="@settings.SearchIntervalSeconds"
     data-step="@settings.SearchRadiusStepMeters"
     data-max="@settings.MaxRadiusMeters"
     data-proxies='@proxiesJson'
     data-radar-configs='@radarConfigsJson'
     data-dynamic='@System.Text.Json.JsonSerializer.Serialize(new { Model.DynamicData.Enabled, Model.DynamicData.Provider }, jsonOpts)'></div>

<div class="dash-toolbar">
    <input id="configName" class="input" placeholder="Config name" style="width:150px" />
    <select id="configSelect" class="input" style="max-width:220px">
        <option value="">Saved configs...</option>
    </select>
    <button id="saveConfigBtn" class="btn dark">&#128190; Save</button>
    <button id="startAllBtn" class="btn green">&#9654; Start All</button>
    <button id="stopAllBtn" class="btn red">&#9632; Stop All</button>
</div>

<div class="grid-6">
    @for (int i = 1; i <= 5; i++)
    {
        <section class="inst-card" id="card-@i">
            <div class="inst-head">
                <span class="inst-icon">@i</span>
                <span class="inst-title">Instance @i</span>
                <span class="inst-status" id="status-@i">Idle</span>
                <span class="inst-found" id="found-@i" style="display:none"></span>
                <button class="inst-collapse" onclick="Dashboard.toggleCollapse(@i)" title="Collapse">&#9662;</button>
            </div>
            <div class="inst-body" id="body-@i">
                <div class="inst-controls">
                    <div class="names-wrap">
                        <input id="names-@i" class="input names-input" placeholder="alert, park"
                               value="alert, park" oninput="Dashboard.onNamesInput(@i)" />
                        <button class="names-toggle" onclick="Dashboard.toggleNamesPop(@i)">&#9662;</button>
                        <div id="namespop-@i" class="names-pop" style="display:none"></div>
                    </div>
                    <button id="search-@i" class="btn primary" onclick="Dashboard.toggleSearch(@i)">&#128269; Search</button>
                    <label class="checkbox"><input type="checkbox" id="loop-@i" onchange="Dashboard.onLoop(@i)" /> Loop</label>
                </div>
                <div class="proxy-wrap">
                    <span class="loc-ico">&#128205;</span>
                    <select id="proxy-@i" class="input proxy-select" onchange="Dashboard.onProxy(@i)"></select>
                </div>
                <div class="map-wrap">
                    <div id="map-@i" class="map"></div>
                    <div id="pill-@i" class="map-pill">Search location</div>
                    <div id="flash-@i" class="flash-banner" style="display:none"></div>
                </div>
                <div id="threads-@i"></div>
            </div>
        </section>
    }

    <section class="inst-card" id="card-6">
        <div class="inst-head">
            <span class="inst-icon">6</span>
            <span class="inst-title">Instance 6 - WiseGuard</span>
            <span class="inst-status" id="guard-status">Idle</span>
            <button class="inst-collapse" onclick="Dashboard.toggleCollapse(6)" title="Collapse">&#9662;</button>
        </div>
        <div class="inst-body" id="body-6">
            <p class="guard-sub">Speak in Telugu — see it as text</p>
            <div class="guard-top">
                <button id="micBtn" class="mic-btn" onclick="Guard.toggleListening()">&#127908;</button>
                <div>
                    <div class="mic-label" id="micLabel">TAP TO START</div>
                    <div class="muted small" id="micState"></div>
                </div>
                <div class="guard-actions">
                    <button class="icon-btn" title="Toggle word tracker config" onclick="Guard.toggleConfig()">&#9881;</button>
                    <button class="icon-btn" title="Maximize video" onclick="Guard.toggleVideoMax()">&#x26F6;</button>
                </div>
            </div>
            <div id="wordConfig" class="word-config" style="display:none">
                <div class="inst-controls">
                    <input id="wordInput" class="input" style="flex:1" placeholder="Add tracked word(s), comma separated"
                           onkeydown="if(event.key==='Enter')Guard.addWord()" />
                    <button class="btn small" onclick="Guard.addVideoFromList()">Reload video</button>
                </div>
                <div id="wordList" class="chip-row"></div>
                <div class="inst-controls">
                    <input id="videoUrl" class="input" style="flex:1" placeholder="YouTube URL" />
                    <button class="btn small" onclick="Guard.addVideo()">Add video</button>
                </div>
                <div id="videoList" class="video-list"></div>
            </div>
            <div class="transcript-box" id="transcript">
                <span class="placeholder">Your Telugu speech will appear here...</span>
            </div>
            <div class="interim" id="interim"></div>
            <div class="guard-video" id="videoPlayer"></div>
            <div class="video-controls">
                <button class="btn small primary" onclick="Guard.togglePause()">Pause</button>
                <button class="btn small" onclick="Guard.stopVideo()">Stop</button>
                <label class="checkbox"><input type="checkbox" id="videoLoop" checked onchange="Guard.onLoopChange()" /> Loop</label>
                <input type="range" id="videoSlider" class="video-slider" min="0" max="100" value="0"
                       oninput="Guard.onSeek(this.value)" />
            </div>
            <div class="counts-head">Repeat Counts <button class="link-btn small" onclick="Guard.resetCounts()">reset</button></div>
            <div id="wordCounts" class="counts-list"></div>
        </div>
    </section>
</div>

@section Scripts {
<script src="~/js/dashboard.js" asp-append-version="true"></script>
<script src="~/js/guard.js" asp-append-version="true"></script>
<script>Dashboard.init(); Guard.init();</script>
}
