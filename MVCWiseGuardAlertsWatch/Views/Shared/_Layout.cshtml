<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WiseGuardAlertsWatch</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="brand">
            <span class="brand-badge">&#128205;</span>
            <span>Location Radar</span>
            <span class="brand-sub">6 instances</span>
        </div>
        <div class="topbar-right">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="link-btn" asp-controller="Settings" asp-action="Index" title="Settings">&#9881; Settings</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                    <button type="submit" class="btn small">Sign out</button>
                </form>
            }
            else
            {
                <a class="link-btn" asp-controller="Account" asp-action="Login">Sign in</a>
            }
        </div>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
