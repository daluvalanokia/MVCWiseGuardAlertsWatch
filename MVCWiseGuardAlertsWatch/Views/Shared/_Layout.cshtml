<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WiseGuardAlertsWatch</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="brand"><span class="brand-icon">&#128737;</span> WiseGuardAlertsWatch</div>
        <nav>
            <a asp-controller="Home" asp-action="Index">Dashboard</a>
            <a asp-controller="Settings" asp-action="Index">Settings</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                    <button type="submit" class="link-btn">Sign out</button>
                </form>
            }
        </nav>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
